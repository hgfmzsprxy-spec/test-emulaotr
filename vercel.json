{
  "version": 2,
  "buildCommand": "node scripts/prepare-vercel.js",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{server.js,affiliates-api.js,checkout/**,css/**,js/**,data/**}"
    }
  },
  "rewrites": [
    { "source": "/order", "destination": "/api/handler" },
    { "source": "/order/:id", "destination": "/api/handler" },
    { "source": "/invoice/:id", "destination": "/api/handler" },
    { "source": "/admin", "destination": "/api/handler" },
    { "source": "/affiliates", "destination": "/api/handler" },
    { "source": "/settings", "destination": "/api/handler" },
    { "source": "/clients/:path*", "destination": "/api/handler" }
  ]
}
